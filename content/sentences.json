[
  {
    "id": "L1-01",
    "level": 1,
    "text": "아침에 물을 마셔요.",
    "syllables": 8
  },
  {
    "id": "L1-02",
    "level": 1,
    "text": "오늘은 날씨가 맑아요.",
    "syllables": 9
  },
  {
    "id": "L1-03",
    "level": 1,
    "text": "우리 집은 조용해요.",
    "syllables": 8
  },
  {
    "id": "L1-04",
    "level": 1,
    "text": "엄마와 시장에 가요.",
    "syllables": 8
  },
  {
    "id": "L1-05",
    "level": 1,
    "text": "나무 아래에서 쉬어요.",
    "syllables": 9
  },
  {
    "id": "L1-06",
    "level": 1,
    "text": "연필로 이름을 써요.",
    "syllables": 8
  },
  {
    "id": "L1-07",
    "level": 1,
    "text": "아이가 노래를 불러요.",
    "syllables": 9
  },
  {
    "id": "L1-08",
    "level": 1,
    "text": "이번 주말에 만나요.",
    "syllables": 8
  },
  {
    "id": "L1-09",
    "level": 1,
    "text": "우유를 한 잔 주세요.",
    "syllables": 8
  },
  {
    "id": "L1-10",
    "level": 1,
    "text": "오후에 비가 내려요.",
    "syllables": 8
  },
  {
    "id": "L1-11",
    "level": 1,
    "text": "얼음이 천천히 녹아요.",
    "syllables": 9
  },
  {
    "id": "L1-12",
    "level": 1,
    "text": "여름 바다는 넓어요.",
    "syllables": 8
  },
  {
    "id": "L1-13",
    "level": 1,
    "text": "운동화를 새로 샀어요.",
    "syllables": 9
  },
  {
    "id": "L1-14",
    "level": 1,
    "text": "나는 국수를 좋아해요.",
    "syllables": 9
  },
  {
    "id": "L1-15",
    "level": 1,
    "text": "아빠가 신문을 읽어요.",
    "syllables": 9
  },
  {
    "id": "L1-16",
    "level": 1,
    "text": "은행은 어디에 있나요?",
    "syllables": 9
  },
  {
    "id": "L1-17",
    "level": 1,
    "text": "오이를 길게 잘라요.",
    "syllables": 8
  },
  {
    "id": "L1-18",
    "level": 1,
    "text": "노을이 아름다워요.",
    "syllables": 8
  },
  {
    "id": "L1-19",
    "level": 1,
    "text": "마당에 꽃이 피었어요.",
    "syllables": 9
  },
  {
    "id": "L1-20",
    "level": 1,
    "text": "이 길로 가면 돼요.",
    "syllables": 7
  },
  {
    "id": "L1-21",
    "level": 1,
    "text": "의자에 앉아 주세요.",
    "syllables": 8
  },
  {
    "id": "L1-22",
    "level": 1,
    "text": "내일 아침에 전화할게요.",
    "syllables": 10
  },
  {
    "id": "L1-23",
    "level": 1,
    "text": "강아지가 문 앞에 있어요.",
    "syllables": 10
  },
  {
    "id": "L1-24",
    "level": 1,
    "text": "우산을 챙겨 가세요.",
    "syllables": 8
  },
  {
    "id": "L1-25",
    "level": 1,
    "text": "영화가 곧 시작해요.",
    "syllables": 8
  },
  {
    "id": "L1-26",
    "level": 1,
    "text": "물고기가 헤엄쳐요.",
    "syllables": 8
  },
  {
    "id": "L1-27",
    "level": 1,
    "text": "어제는 일찍 잤어요.",
    "syllables": 8
  },
  {
    "id": "L1-28",
    "level": 1,
    "text": "냉장고에 과일이 있어요.",
    "syllables": 10
  },
  {
    "id": "L1-29",
    "level": 1,
    "text": "요즘 책을 많이 읽어요.",
    "syllables": 9
  },
  {
    "id": "L1-30",
    "level": 1,
    "text": "버스가 금방 올 거예요.",
    "syllables": 9
  },
  {
    "id": "L2-01",
    "level": 2,
    "text": "주말마다 가족과 함께 공원을 천천히 걸어요.",
    "syllables": 18
  },
  {
    "id": "L2-02",
    "level": 2,
    "text": "오늘 점심에는 따뜻한 된장찌개를 먹었어요.",
    "syllables": 18
  },
  {
    "id": "L2-03",
    "level": 2,
    "text": "회의가 끝나면 자료를 정리해서 보내 드릴게요.",
    "syllables": 19
  },
  {
    "id": "L2-04",
    "level": 2,
    "text": "지하철역에서 내려서 오른쪽으로 조금 걸으세요.",
    "syllables": 20
  },
  {
    "id": "L2-05",
    "level": 2,
    "text": "아침마다 창문을 열고 맑은 공기를 마셔요.",
    "syllables": 17
  },
  {
    "id": "L2-06",
    "level": 2,
    "text": "도서관에서 빌린 책을 다음 주까지 반납해야 해요.",
    "syllables": 20
  },
  {
    "id": "L2-07",
    "level": 2,
    "text": "동생이 좋아하는 케이크를 사서 집에 갔어요.",
    "syllables": 18
  },
  {
    "id": "L2-08",
    "level": 2,
    "text": "새로 생긴 카페는 조용해서 공부하기 좋아요.",
    "syllables": 18
  },
  {
    "id": "L2-09",
    "level": 2,
    "text": "비가 많이 와서 약속을 내일로 미루었어요.",
    "syllables": 17
  },
  {
    "id": "L2-10",
    "level": 2,
    "text": "이번 여행에서는 바닷가 마을에 머물 예정이에요.",
    "syllables": 20
  },
  {
    "id": "L2-11",
    "level": 2,
    "text": "감기에 걸려서 따뜻한 차를 자주 마시고 있어요.",
    "syllables": 19
  },
  {
    "id": "L2-12",
    "level": 2,
    "text": "우리 반 친구들은 점심시간에 축구를 해요.",
    "syllables": 17
  },
  {
    "id": "L2-13",
    "level": 2,
    "text": "휴대폰 화면이 깨져서 수리점에 맡겼어요.",
    "syllables": 17
  },
  {
    "id": "L2-14",
    "level": 2,
    "text": "저녁을 먹고 나서 가볍게 동네를 산책했어요.",
    "syllables": 18
  },
  {
    "id": "L2-15",
    "level": 2,
    "text": "오랜만에 친구에게 연락이 와서 반가웠어요.",
    "syllables": 18
  },
  {
    "id": "L2-16",
    "level": 2,
    "text": "내일은 아침 일찍 일어나서 운동을 할 거예요.",
    "syllables": 18
  },
  {
    "id": "L2-17",
    "level": 2,
    "text": "장을 보러 가기 전에 필요한 것을 적어 두세요.",
    "syllables": 18
  },
  {
    "id": "L2-18",
    "level": 2,
    "text": "할머니 댁 마당에는 커다란 감나무가 있어요.",
    "syllables": 18
  },
  {
    "id": "L2-19",
    "level": 2,
    "text": "버스를 놓쳐서 다음 차를 한참 동안 기다렸어요.",
    "syllables": 19
  },
  {
    "id": "L2-20",
    "level": 2,
    "text": "새 학기가 시작되면 시간표를 다시 짜야 해요.",
    "syllables": 18
  },
  {
    "id": "L2-21",
    "level": 2,
    "text": "노트북 배터리가 거의 다 떨어져 가요.",
    "syllables": 15
  },
  {
    "id": "L2-22",
    "level": 2,
    "text": "이 음식은 맵지 않아서 아이들도 잘 먹어요.",
    "syllables": 17
  },
  {
    "id": "L2-23",
    "level": 2,
    "text": "주문하신 물건은 내일 오후에 도착할 예정입니다.",
    "syllables": 20
  },
  {
    "id": "L2-24",
    "level": 2,
    "text": "겨울이 오기 전에 두꺼운 이불을 꺼내 두었어요.",
    "syllables": 19
  },
  {
    "id": "L2-25",
    "level": 2,
    "text": "영화관에 가려면 미리 표를 예매하는 게 좋아요.",
    "syllables": 19
  },
  {
    "id": "L2-26",
    "level": 2,
    "text": "엘리베이터가 고장 나서 계단으로 올라갔어요.",
    "syllables": 19
  },
  {
    "id": "L2-27",
    "level": 2,
    "text": "요리를 배우고 나서 집밥을 자주 해 먹어요.",
    "syllables": 17
  },
  {
    "id": "L2-28",
    "level": 2,
    "text": "오늘 수업에서는 조별로 발표를 준비했어요.",
    "syllables": 18
  },
  {
    "id": "L2-29",
    "level": 2,
    "text": "아이들이 놀이터에서 신나게 뛰어놀고 있어요.",
    "syllables": 19
  },
  {
    "id": "L2-30",
    "level": 2,
    "text": "다음 달에는 이사를 해서 조금 바쁠 것 같아요.",
    "syllables": 18
  },
  {
    "id": "L3-01",
    "level": 3,
    "text": "처음 보는 사람에게 길을 물어보는 일은 생각보다 어렵지 않았어요.",
    "syllables": 27
  },
  {
    "id": "L3-02",
    "level": 3,
    "text": "회사 근처에 새로 생긴 식당은 점심시간마다 사람들로 붐벼요.",
    "syllables": 25
  },
  {
    "id": "L3-03",
    "level": 3,
    "text": "주말에는 오랜만에 대청소를 하고 안 쓰는 물건을 정리할 생각이에요.",
    "syllables": 28
  },
  {
    "id": "L3-04",
    "level": 3,
    "text": "발표를 앞두고 긴장이 되었지만 천천히 말하니까 훨씬 편안했어요.",
    "syllables": 27
  },
  {
    "id": "L3-05",
    "level": 3,
    "text": "이번 겨울에는 따뜻한 남쪽 지방으로 가족 여행을 가기로 했어요.",
    "syllables": 26
  },
  {
    "id": "L3-06",
    "level": 3,
    "text": "매일 조금씩이라도 꾸준히 연습하면 분명히 좋아질 거라고 믿어요.",
    "syllables": 27
  },
  {
    "id": "L3-07",
    "level": 3,
    "text": "전화로 예약을 변경하려고 했는데 상담원이 친절하게 도와주었어요.",
    "syllables": 28
  },
  {
    "id": "L3-08",
    "level": 3,
    "text": "아침 출근길 지하철은 늘 복잡하지만 음악을 들으면 견딜 만해요.",
    "syllables": 26
  },
  {
    "id": "L3-09",
    "level": 3,
    "text": "동네 도서관에서 매달 열리는 독서 모임에 처음으로 참석했어요.",
    "syllables": 26
  },
  {
    "id": "L3-10",
    "level": 3,
    "text": "오늘 저녁에는 친구들과 모여서 맛있는 음식을 나눠 먹기로 했어요.",
    "syllables": 27
  },
  {
    "id": "L3-11",
    "level": 3,
    "text": "감독님은 경기가 끝난 뒤에 선수들에게 수고했다고 말씀하셨어요.",
    "syllables": 27
  },
  {
    "id": "L3-12",
    "level": 3,
    "text": "컴퓨터가 갑자기 꺼져서 작성하던 문서를 처음부터 다시 써야 했어요.",
    "syllables": 28
  },
  {
    "id": "L3-13",
    "level": 3,
    "text": "공원 산책로를 따라 걷다 보면 계절마다 다른 꽃을 볼 수 있어요.",
    "syllables": 25
  },
  {
    "id": "L3-14",
    "level": 3,
    "text": "면접에서는 준비한 내용을 차분하게 이야기하는 것이 가장 중요해요.",
    "syllables": 28
  },
  {
    "id": "L3-15",
    "level": 3,
    "text": "비행기 출발 시간이 늦어져서 공항에서 두 시간 넘게 기다렸어요.",
    "syllables": 26
  },
  {
    "id": "L3-16",
    "level": 3,
    "text": "새로 이사 온 이웃이 떡을 가지고 인사하러 와서 정말 고마웠어요.",
    "syllables": 26
  },
  {
    "id": "L3-17",
    "level": 3,
    "text": "아이가 처음으로 자전거를 혼자 타게 된 날을 아직도 기억해요.",
    "syllables": 25
  },
  {
    "id": "L3-18",
    "level": 3,
    "text": "마트에서 계산을 하려는데 지갑을 집에 두고 온 걸 알게 되었어요.",
    "syllables": 26
  },
  {
    "id": "L3-19",
    "level": 3,
    "text": "오래된 사진첩을 넘겨 보니 어릴 때 살던 동네가 그리워졌어요.",
    "syllables": 25
  },
  {
    "id": "L3-20",
    "level": 3,
    "text": "선생님께서는 질문이 있으면 언제든지 편하게 물어보라고 하셨어요.",
    "syllables": 28
  },
  {
    "id": "L3-21",
    "level": 3,
    "text": "다음 주 회의에서는 지난 분기의 결과와 앞으로의 계획을 발표해요.",
    "syllables": 27
  },
  {
    "id": "L3-22",
    "level": 3,
    "text": "날씨가 좋아서 창문을 활짝 열어 두었더니 방 안이 상쾌해졌어요.",
    "syllables": 26
  },
  {
    "id": "L3-23",
    "level": 3,
    "text": "택시를 타고 목적지를 말하는데 기사님이 한 번 더 물어보셨어요.",
    "syllables": 26
  },
  {
    "id": "L3-24",
    "level": 3,
    "text": "처음 가 보는 미용실에서 원하는 머리 모양을 자세히 설명했어요.",
    "syllables": 26
  },
  {
    "id": "L3-25",
    "level": 3,
    "text": "건강을 위해서 엘리베이터 대신 계단을 이용하는 습관을 들이고 있어요.",
    "syllables": 29
  },
  {
    "id": "L3-26",
    "level": 3,
    "text": "학교 축제에서 우리 반은 연극을 하기로 하고 매일 연습을 했어요.",
    "syllables": 26
  },
  {
    "id": "L3-27",
    "level": 3,
    "text": "은행 창구에서 통장을 새로 만들려면 신분증을 꼭 가져가야 해요.",
    "syllables": 26
  },
  {
    "id": "L3-28",
    "level": 3,
    "text": "여행을 떠나기 전날 밤에는 설레는 마음에 잠이 잘 오지 않았어요.",
    "syllables": 26
  },
  {
    "id": "L3-29",
    "level": 3,
    "text": "모르는 번호로 전화가 왔지만 용기를 내서 먼저 인사를 건넸어요.",
    "syllables": 26
  },
  {
    "id": "L3-30",
    "level": 3,
    "text": "오늘 하루도 무사히 끝났으니 따뜻한 물로 씻고 일찍 쉬어야겠어요.",
    "syllables": 27
  }
]
